# ── Priora Frontend — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values.
# cp .env.example .env

# ── Backend API ──────────────────────────────────────────────────────
# URL of the Rust/Axum backend API (required).
# Development: http://127.0.0.1:3001/api
# Production: https://your-backend.fly.dev/api
NUXT_API_BASE=http://127.0.0.1:3001/api

# ── Public API Base ──────────────────────────────────────────────────
# Public-facing API path (used by client-side $fetch).
# For same-domain proxy: leave as '/api' (Nuxt server routes handle forwarding).
# For separate domains: set to the full backend URL.
NUXT_PUBLIC_API_BASE=/api

# ── Site URL ─────────────────────────────────────────────────────────
# Used for sitemap, canonical URLs, and OG meta tags.
# Example: https://priora.ktu
NUXT_PUBLIC_SITE_URL=https://priora.ktu
